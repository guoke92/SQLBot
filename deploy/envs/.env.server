PROJECT_NAME="AI智能问数"

# ── 数据库（同机 PostgreSQL）──
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sqlbot
POSTGRES_USER=root
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# ── 认证 ──
SECRET_KEY=__SECRET_KEY__
DEFAULT_PWD=Lls@123456
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ── CORS / 对外地址（通配，不绑定具体 IP）──
FRONTEND_HOST=http://localhost
BACKEND_CORS_ORIGINS="http://localhost,http://127.0.0.1,http://localhost:3001,http://127.0.0.1:3001"

# ── 部署路径（固定 /opt/sqlbot）──
BASE_DIR=/opt/sqlbot
UPLOAD_DIR=/opt/sqlbot/data/file
MCP_IMAGE_PATH=/opt/sqlbot/data/images
EXCEL_PATH=/opt/sqlbot/data/excel
LOG_DIR=/opt/sqlbot/data/logs
LOCAL_MODEL_PATH=/opt/sqlbot/data/models

# ── 日志 / 缓存 ──
LOG_LEVEL=INFO
SQL_DEBUG=False
CACHE_TYPE=memory

# ── MCP / SSR ──
SERVER_IMAGE_HOST=http://localhost:8001/images/
MCP_IMAGE_HOST=http://127.0.0.1:3000

# ── Embedding（云端 OpenAI 兼容，密钥由打包脚本从本地 .env 继承）──
EMBEDDING_ENABLED=True
TABLE_EMBEDDING_ENABLED=True
EMBEDDING_PROVIDER=openai
EMBEDDING_API_BASE=__EMBEDDING_API_BASE__
EMBEDDING_API_KEY=__EMBEDDING_API_KEY__
DEFAULT_EMBEDDING_MODEL=__DEFAULT_EMBEDDING_MODEL__
EMBEDDING_DEFAULT_SIMILARITY=0.4

# ── 其他 ──
CONTEXT_PATH=
SQLBOT_DOC_ENABLED=True
API_SSRF_ALLOW_PRIVATE=true
