[Unit]
Description=SQLBot Backend (FastAPI)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sqlbot/app
EnvironmentFile=/opt/sqlbot/.env
ExecStart=/opt/sqlbot/app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips='*'
Restart=always
RestartSec=5
# 后端日志输出到 journald；应用自身也写 data/logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
