rameters': {'properties': {'ds_id': {'type': 'integer'}, 'table_id': {'anyOf': [{'type': 'integer'}, {'type': 'null'}], 'default': None}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'configure_dictionary_field', 'description': 'Create or replace dictionary settings for one datasource field.', 'parameters': {'properties': {'ds_id': {'type': 'integer'}, 'field_id': {'type': 'integer'}, 'enabled': {'default': True, 'type': 'boolean'}, 'max_values': {'default': 500, 'maximum': 5000, 'minimum': 1, 'type': 'integer'}}, 'required': ['ds_id', 'field_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'update_dictionary_config', 'description': 'Update an existing dictionary configuration by config id.', 'parameters': {'properties': {'config_id': {'type': 'integer'}, 'enabled': {'anyOf': [{'type': 'boolean'}, {'type': 'null'}], 'default': None}, 'max_values': {'anyOf': [{'maximum': 5000, 'minimum': 1, 'type': 'integer'}, {'type': 'null'}], 'default': None}}, 'required': ['config_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'refresh_dictionary_values', 'description': 'Extract and publish current values for dictionary configurations.', 'parameters': {'properties': {'config_ids': {'items': {'type': 'integer'}, 'type': 'array'}}, 'required': ['config_ids'], 'type': 'object'}}}]}}
