选项必须直接使用该范围，并绑定实际业务时间字段；不得创建没有 fields 的独立“年份范围”槽位。\n- 已有契约槽位是锁定事实；除 refine 的显式 replace/remove 外不得改写，也不得重复提问。\n- 只有现有证据无法提供可执行选项才 blocked；存在合理选项则 needs_clarification；所有槽位明确后 ready。\n- ready 必须能形成非空契约，且 edits/issues/questions 互不冲突。\n- 所有面向用户的 title/reason/label/description/impact 使用业务语言，不出现数据库实现术语。\n- 输出必须严格符合随后提供的 JSON Schema，不要 Markdown，也不要输出 schema 之外的字段。\n\n所有面向用户的文本必须使用当前会话语言：简体中文\n必须符合以下 JSON Schema：\n{"$defs":{"ClarificationQuestion":{"additionalProperties":false,"properties":{"id":{"title":"Id","type":"string"},"slot_ids":{"items":{"type":"string"},"title":"Slot Ids","type":"array"},"title":{"title":"Title","type":"string"},"reason":{"default":"","title":"Reason","type":"string"},"selection_type":{"default":"single","enum":["single","multiple","text"],"title":"Selection Type","type":"string"},"required":{"default":true,"title":"Required","type":"boolean"},"recommended_option_ids":{"items":{"type":"string"},"title":"Recommended Option Ids","type":"array"},"recommendation_reason":{"default":"","title":"Recommendation Reason","type":"string"},"recommendation_strength":{"default":"weak","enum":["strong","moderate","weak"],"title":"Recommendation Strength","type":"string"},"options":{"items":{"$ref":"#/$defs/IntentOption"},"title":"Options","type":"array"},"allow_custom":{"default":true,"title":"Allow Custom","type":"boolean"},"custom_placeholder":{"default":"","title":"Custom Placeholder","type":"string"}},"required":["id","title"],"title":"ClarificationQuestion","type":"object"},"FieldRef":{"additionalProperties":false,"description":"A physical field identity qualified when a resource is known.","properties":{"resource":{"default":"","title":"Resource","type":"string"},"field":{"title":"Field","type":"string"}},"required":["field"],"title":"FieldRef","type":"object"},"GroupRequirement":{"additionalProperties":false,"properties":{"slot_id":{"title":"Slot Id","type":"string"},"label":{"title":"Label","type":"string"},"source":{"default":"user","enum":["user","rule"