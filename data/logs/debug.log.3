 \\"llsclient_id\\": \\"000006创维集团\\",\\n    \\"deal_time\\": \\"2026-07-28 07:28:14\\",\\n    \\"asset_no\\": \\"WEC-20190925172445239\\",\\n    \\"core_company_name\\": \\"创维光电科技（深圳）有限公司\\",\\n    \\"company_name\\": \\"深圳市鑫裕达塑胶模具有限公司\\"\\n  },\\n  {\\n    \\"id\\": 50,\\n    \\"core_company_id\\": 6567964917591183360,\\n    \\"company_id\\": 6564747136976556032,\\n    \\"project_id\\": 100004,\\n    \\"project_mark\\": \\"cw\\",\\n    \\"llsclient_id\\": \\"000006创维集团\\",\\n    \\"deal_time\\": \\"2026-07-28 07:28:14\\",\\n    \\"asset_no\\": \\"WEC-20191009172920411\\",\\n    \\"core_company_name\\": \\"广州创维平面显示科技有限公司\\",\\n    \\"company_name\\": \\"无锡利朗电子有限公司\\"\\n  }\\n]","terminology":"","query_examples":"","custom_rules":"","entity_bindings":{"candidates":[],"resolved":{},"ambiguous":{},"match_count":0}}', 'role': 'user'}, {'content': '{\n  "intent_mode": "new",\n  "status": "needs_clarification",\n  "summary": "需汇总今年企业的累计签收额与累积融资额，并带出对应核企名称与供应商层级；企业主体、两项金额口径及“今年”所依据的业务日期仍会影响结果，需先确认。",\n  "edits": [],\n  "issues": [\n    {\n      "slot_id": "grp_enterprise",\n      "clause": "group",\n      "label": "汇总企业主体",\n      "reason": "未明确“企业”是申请融资企业、原始供应商还是其他主体，分组对象不同会直接改变每一行代表谁以及汇总结果。",\n      "allow_omit": false,\n      "evidence_refs": ["user.question"]\n    },\n    {\n      "slot_id": "grp_core_company",\n      "clause": "group",\n      "label": "核企名称",\n      "reason": "需要按核企名称展示，但需确认是否与企业主体一并作为分组维度，以及是否采用核心企业名称字段。",\n      "allow_omit": false,\n      "evidence_refs": ["user.question"]\n    },\n    {\n      "slot_id": "grp_supplier_level",\n      "clause": "group",\n      "label": "供应商层级",\n      "reason": "需要展示供应商层级；需确认是否指资产层级，并作为分组维度与企业、核企一起汇总。",\n      "allow_omit": false,\n      "evidence_refs": ["user.question"]\n    },\n    {\n      "slot_id": "out_sign_amt",\n      "clause": "output",\n      "label": "累计签收额",\n      "reason": "“累计签收额”未对应到唯一业务金额字段，选错金额会实质改变汇总值。",\n      "allow_omit": false,\n      "evidence_refs": ["user.question"]\n    },\n    {\n      "slot_id": "out_fin_amt",\n      "clause": "output",\n      "label": "累积融资额",\n      "reason": "“累积融资额”可能对应融资申请金额或其他融资金额字段，口径不同会改变汇总值。",\n      "allow_omit": false,\n      "evidence_refs": ["user.question"]\n    },\n    {\n      "slot_id": "tw_year",\n      "clause": "time_window",\n      "label": "今年业务时间范围",\n      "reason": "已解析出今年为 2026-01-01 至 2027-01-01（不含当日），但签收与融资应落在哪个业务日期上会改变哪些记录计入汇总。",\n      "allow_omit": false,\n      "evidence_refs": ["user.question", "deterministic_time_parse"]\n    }\n  ],\n  "questions": [\n    {\n      "id": "q_enterprise_dims",\n      "slot_ids": ["grp_enterprise", "grp_core_company", "grp_supplier_level"],\n      "title": "汇总时，“企业”、核企名称、供应商层级分别按什么来看？",\n      "reason": "这三项决定每一行代表的业务主体组合，以及核企、层级如何对应到企业。",\n      "selection_type": "single",\n      "required": true,\n      "recommended_option_ids": ["opt_fin_applicant_core_level"],\n      "recommendation_reason": "融资明细中同时具备申请融资企业、核心企业与资产层级，和“签收/融资 + 核企 + 供应商层级”的表述最贴近。",\n      "recommendation_strength": "moderate",\n      "options": [\n        {\n          "id": "opt_fin_applicant_core_level",\n          "label": "按申请融资企业汇总，并带出核心企业、资产层级",\n          "description": "每一行是一个申请融资企业 + 其对应核心企业名称 + 资产层级（作为供应商层级）的组合。",\n          "impact": "同一申请融资企业若对应多个核企或层级，会拆成多行分别汇总。",\n          "evidence_refs": ["user.question", "schema"],\n          "effects": [\n            {\n              "slot_id": "grp_enterprise",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_enterprise",\n                "label": "申请融资企业",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_mid_crm_wec_xun_core_fin_list",\n                  "field": "sed_company_name"\n                },\n                "bucket": null\n              }\n            },\n            {\n              "slot_id": "grp_core_company",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_core_company",\n                "label": "核企名称",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_mid_crm_wec_xun_core_fin_list",\n                  "field": "core_company_name"\n                },\n                "bucket": null\n              }\n            },\n            {\n              "slot_id": "grp_supplier_level",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_supplier_level",\n                "label": "供应商层级（资产层级）",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_mid_crm_wec_xun_core_fin_list",\n                  "field": "apply_level"\n                },\n                "bucket": null\n              }\n            }\n          ]\n        },\n        {\n          "id": "opt_orig_supplier_core_level",\n          "label": "按原始供应商汇总，并带出核心企业、资产层级",\n          "description": "每一行是一个原始供应商 + 其对应核心企业名称 + 资产层级的组合。",\n          "impact": "与“申请融资企业”不一致时，企业名单和汇总金额都会不同。",\n          "evidence_refs": ["user.question", "schema"],\n          "effects": [\n            {\n              "slot_id": "grp_enterprise",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_enterprise",\n                "label": "原始供应商",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_mid_crm_wec_xun_core_fin_list",\n                  "field": "company_name"\n                },\n                "bucket": null\n              }\n            },\n            {\n              "slot_id": "grp_core_company",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_core_company",\n                "label": "核企名称",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_mid_crm_wec_xun_core_fin_list",\n                  "field": "core_company_name"\n                },\n                "bucket": null\n              }\n            },\n            {\n              "slot_id": "grp_supplier_level",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_supplier_level",\n                "label": "供应商层级（资产层级）",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_mid_crm_wec_xun_core_fin_list",\n                  "field": "apply_level"\n                },\n                "bucket": null\n              }\n            }\n          ]\n        },\n        {\n          "id": "opt_online_supplier_core_only",\n          "label": "按线上资产中的供应商与核心企业汇总（不含资产层级）",\n          "description": "使用线上资产侧的供应商、核心企业名称；若供应商层级不在该侧，则不按层级拆分。",\n          "impact": "无法按资产层级拆分；签收/融资若仍取融资侧指标，还需再约定两套数据如何对应。",\n          "evidence_refs": ["user.question", "schema"],\n          "effects": [\n            {\n              "slot_id": "grp_enterprise",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_enterprise",\n                "label": "供应商",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_zhanke_wec_online_asset_list",\n                  "field": "company_name"\n                },\n                "bucket": null\n              }\n            },\n            {\n              "slot_id": "grp_core_company",\n              "action": "set",\n              "requirement": {\n                "slot_id": "grp_core_company",\n                "label": "核企名称",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "group",\n                "field": {\n                  "resource": "dw_zhanke_wec_online_asset_list",\n                  "field": "core_company_name"\n                },\n                "bucket": null\n              }\n            },\n            {\n              "slot_id": "grp_supplier_level",\n              "action": "omit",\n              "requirement": null\n            }\n          ]\n        }\n      ],\n      "allow_custom": true,\n      "custom_placeholder": "请说明企业、核企、供应商层级分别指什么业务名称"\n    },\n    {\n      "id": "q_metrics_and_time",\n      "slot_ids": ["out_sign_amt", "out_fin_amt", "tw_year"],\n      "title": "累计签收额、累积融资额分别按什么金额，以及“今年”按哪个业务日期统计？",\n      "reason": "金额字段与日期字段一旦选错，计入的明细和两个汇总值都会变化；今年已确定为 2026-01-01（含）至 2027-01-01（不含）。",\n      "selection_type": "single",\n      "required": true,\n      "recommended_option_ids": ["opt_sign_by_sign_date_fin_by_apply"],\n      "recommendation_reason": "名称上“签收额”更贴近签收日，“融资额”更贴近融资申请金额与融资申请日期。",\n      "recommendation_strength": "moderate",\n      "options": [\n        {\n          "id": "opt_sign_by_sign_date_fin_by_apply",\n          "label": "签收额=原始资产金额（按签收日）；融资额=融资申请金额（按融资申请日）",\n          "description": "两个指标都在融资明细中统计；今年同时约束签收日与融资申请日。",\n          "impact": "仅签收日落在今年的明细计入签收额相关过滤，仅融资申请日落在今年的明细计入融资额相关过滤；若同一时间窗绑定两个日期字段，需按“均在今年”理解入账范围。",\n          "evidence_refs": ["user.question", "deterministic_time_parse", "schema"],\n          "effects": [\n            {\n              "slot_id": "out_sign_amt",\n              "action": "set",\n              "requirement": {\n                "slot_id": "out_sign_amt",\n                "label": "累计签收额",\n                "source": "user",\n                "evidence_refs": ["user.question"],\n                "clause": "output",\n         