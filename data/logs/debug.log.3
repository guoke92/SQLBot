ref":"#/$defs/QueryPlanCandidate"},"minItems":1,"title":"Candidates","type":"array"},"summary":{"default":"","title":"Summary","type":"string"}},"required":["specification","candidates"],"title":"Ready","type":"object"},"RelationPair":{"additionalProperties":false,"properties":{"left":{"$ref":"#/$defs/FieldRef"},"right":{"$ref":"#/$defs/FieldRef"}},"required":["left","right"],"title":"RelationPair","type":"object"},"TimeWindowRequirement":{"additionalProperties":false,"properties":{"requirement_id":{"title":"Requirement Id","type":"string"},"business_label":{"title":"Business Label","type":"string"},"evidence_refs":{"default":[],"items":{"type":"string"},"title":"Evidence Refs","type":"array"},"confidence":{"default":0.5,"maximum":1,"minimum":0,"title":"Confidence","type":"number"},"source":{"default":"model","enum":["user","model","terminology","example","schema","knowledge","system_default"],"title":"Source","type":"string"},"status":{"default":"active","enum":["active","superseded","dropped"],"title":"Status","type":"string"},"clause":{"const":"time_window","default":"time_window","title":"Clause","type":"string"},"fields":{"items":{"$ref":"#/$defs/FieldRef"},"title":"Fields","type":"array"},"mode":{"enum":["all","explicit","rolling"],"title":"Mode","type":"string"},"start":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Start"},"end_exclusive":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"End Exclusive"},"rolling_months":{"anyOf":[{"exclusiveMinimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Rolling Months"}},"required":["requirement_id","business_label","fields","mode"],"title":"TimeWindowRequirement","type":"object"}},"anyOf":[{"$ref":"#/$defs/NeedClarification"},{"$ref":"#/$defs/Ready"}]}', 'role': 'system'}, {'content': '{"evidence":[{"evidence_id":"25e28562-9f70-4026-b23c-5d8b60c6c013","reference":"user:question","kind":"user_question","source":"user","content":"汇总今年的企业累计签收额和累积融资额，并查询企业对应的核企名称及供