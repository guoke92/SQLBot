t`\n      INNER JOIN `d_user` `u2` ON `st`.`dispatch_to` = `u2`.`id`\n      INNER JOIN `d_organization` `o2` ON `u2`.`org` = `o2`.`id`\n      WHERE `o2`.`organization_name` = \'研发二部\'\n        AND `st`.`deleted` = \'0\'\n        AND (`u2`.`deleted` = \'0\'\n             OR `u2`.`deleted` IS NULL)\n        AND (`o2`.`deleted` = \'0\'\n             OR `o2`.`deleted` IS NULL)\n        AND `st`.`create_time` >= \'2026-01-01 00:00:00\'\n        AND `st`.`create_time` < \'2027-01-01 00:00:00\'\n        AND `st`.`dispatch_to_name` IS NOT NULL) `x`\n   GROUP BY `x`.`project_id`,\n            `x`.`month`) `k`\nLEFT JOIN\n  (SELECT `tk`.`project_id` AS `project_id`,\n          DATE_FORMAT(`tk`.`create_time`, \'%Y-%m\') AS `month`,\n          COUNT(`tk`.`id`) AS `task_count`\n   FROM `d_task` `tk`\n   INNER JOIN `d_user` `u` ON `tk`.`dispatch_to` = `u`.`id`\n   INNER JOIN `d_organization` `o` ON `u`.`org` = `o`.`id`\n   WHERE `o`.`organization_name` = \'研发二部\'\n     AND `tk`.`deleted` = \'0\'\n     AND (`u`.`deleted` = \'0\'\n          OR `u`.`deleted` IS NULL)\n     AND (`o`.`deleted` = \'0\'\n          OR `o`.`deleted` IS NULL)\n     AND `tk`.`create_time` >= \'2026-01-01 00:00:00\'\n     AND `tk`.`create_time` < \'2027-01-01 00:00:00\'\n     AND `tk`.`dispatch_to_name` IS NOT NULL\n   GROUP BY `tk`.`project_id`,\n            DATE_FORMAT(`tk`.`create_time`, \'%Y-%m\')) `t` ON `k`.`project_id` = `t`.`project_id`\nAND `k`.`month` = `t`.`month`\nLEFT JOIN\n  (SELECT `st`.`project_id` AS `project_id`,\n          DATE_FORMAT(`st`.`create_time`, \'%Y-%m\') AS `month`,\n          COUNT(`st`.`id`) AS `story_count`\n   FROM `d_story` `st`\n   INNER JOIN `d_user` `u2` ON `st`.`dispatch_to` = `u2`.`id`\n   INNER JOIN `d_organization` `o2` ON `u2`.`org` = `o2`.`id`\n   WHERE `o2`.`organization_name` = \'研发二部\'\n     AND `st`.`deleted` = \'0\'\n     AND (`u2`.`deleted` = \'0\'\n          OR `u2`.`deleted` IS NULL)\n     AND (`o2`.`deleted` = \'0\'\n          OR `o2`.`deleted` IS NULL)\n 