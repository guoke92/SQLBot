_name`,\n          `s01`.`name` AS `sprint_name`,\n          COUNT(*) AS `story_count`,\n          0 AS `task_count`,\n          0 AS `case_count`\n   FROM `d_story` `t01`\n   JOIN `d_user` `u01` ON `t01`.`dispatch_to_name` = `u01`.`name`\n   JOIN `d_sprint` `s01` ON `t01`.`sprint_id` = `s01`.`id`\n   JOIN `d_project` `p01` ON `t01`.`project_id` = `p01`.`id`\n   WHERE `t01`.`deleted` = \'0\'\n     AND YEAR(`s01`.`actual_end_time`) = 2026\n   GROUP BY `u01`.`name`,\n            `u01`.`organization_name`,\n            DATE_FORMAT(`s01`.`actual_end_time`, \'%Y-%m\'),\n            `p01`.`code`,\n            `p01`.`project_name`,\n            `s01`.`name`\n   UNION ALL SELECT `u02`.`name` AS `person_name`,\n                    `u02`.`organization_name` AS `org_name`,\n                    DATE_FORMAT(`s02`.`actual_end_time`, \'%Y-%m\') AS `year_month`,\n                    `p02`.`code` AS `code`,\n                    `p02`.`project_name` AS `project_name`,\n                    `s02`.`name` AS `sprint_name`,\n                    0 AS `story_count`,\n                    COUNT(*) AS `task_count`,\n                    0 AS `case_count`\n   FROM `d_task` `t02`\n   JOIN `d_user` `u02` ON `t02`.`dispatch_to_name` = `u02`.`name`\n   JOIN `d_sprint` `s02` ON `t02`.`sprint_id` = `s02`.`id`\n   JOIN `d_project` `p02` ON `t02`.`project_id` = `p02`.`id`\n   WHERE `t02`.`deleted` = \'0\'\n     AND YEAR(`s02`.`actual_end_time`) = 2026\n   GROUP BY `u02`.`name`,\n            `u02`.`organization_name`,\n            DATE_FORMAT(`s02`.`actual_end_time`, \'%Y-%m\'),\n            `p02`.`code`,\n            `p02`.`project_name`,\n            `s02`.`name`\n   UNION ALL SELECT `u03`.`name` AS `person_name`,\n                    `u03`.`organization_name` AS `org_name`,\n                    DATE_FORMAT(`s03`.`actual_end_time`, \'%Y-%m\') AS `year_month`,\n                    `p03`.`code` AS `code`,\n                    `p03`.`project_name` AS `project_name`,\n                    `s03`.`name` AS `sprint_name`,\n                    0 AS `story_count`,\n                    0 AS `task_count`,\n                    COUNT(*) AS `case_count`\n   FROM `d_qa_result` `r03`\n   JOIN `d_qa_case` `c03` ON `r03`.`case_id` = `c03`.`id`\n   JOIN `d_user` `u03` ON `r03`.`test_by` = `u03`.`name`\n   JOIN `d_sprint` `s03` ON `c03`.`sprint_id` = `s03`.`id`\n   JOIN `d_project` `p03` ON `c03`.`project_id1` = `p03`.`id`\n   WHERE `c03`.`deleted` = \'0\'\n     AND YEAR(`s03`.`actual_end_time`) = 2026\n   GROUP BY `u03`.`name`,\n            `u03`.`organization_name`,\n            DATE_FORMAT(`s03`.`actual_end_time`, \'%Y-%m\'),\n            `p03`.`code`,\n            `p03`.`project_name`,\n            `s03`.`name`) `t`\nGROUP BY `t`.`person_name`,\n         `t`.`org_name`,\n         `t`.`year_month`,\n         `t`.`code`,\n         `t`.`project_name`,\n         `t`.`sprint_name`\nLIMIT 1000\n</sql>\n<m-schema>\n【DB_ID】 aio20240430\n【Schema】\n# Table: d_user, 用户信息表，name为姓名（关联story/task/qa_result中的人员），org为所属组织ID（关联d_organization.id）\n[\n(org:bigint, 机构ID),\n(name:varchar, 姓名),\n(related_bus_id:decimal, 关联业务id),\n(phone:varchar, 电话),\n(last_login_time:datetime, 最后登录时间),\n(enable:decimal, 是否有效，0无效，1有效),\n(create_by:varchar, 创建人),\n(organization_name:varchar, 机构名称),\n(table_head:text, 用户行为-表头),\n(company_name:varchar, 企业名称),\n(valid_date:date, 密码生效日期),\n(wc_job_id:varchar, 企微用户工号),\n(wc_depart:varchar, 企微全部部门id),\n(direct_leader_id:bigint, 用户直属领导ID),\n(new_direct_leader_id:bigint, 用户新直属领导ID),\n(user_name:varchar, 用户名),\n(user_type:varchar, 用户类型(管理员等)),\n(status:varchar, 状态),\n(email:varchar, 邮箱),\n(last_login_ip:varchar, 最后登录ip),\n(remark:text, 备注),\n(update_time:datetime, 更新时间),\n(profile_picture:longtext, 头像),\n(select_item:text, 用户行为-筛选项),\n(company_id:bigint, 企业ID),\n(is_ldap_user:varchar, 是否ldap用户，1：是，0否),\n(is_leader:tinyint, 是否部门负责人，1-是，0-否),\n(wc_create_date:date, 企微账户创建日期),\n(need_report_workload:tinyint, 是否需要报工，默认为不需要),\n(id:bigint, 主键id),\n(password:varchar, 密码(md5加密)),\n(busi