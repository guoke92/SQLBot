iguration JSON string (plaintext; system encrypts)'}, 'type': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Protocol type key if changing type'}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'check_datasource', 'description': 'Check datasource connection status.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_catalog_tables', 'description': 'Read-only: list remote catalog tables for a datasource.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_selected_tables', 'description': 'List tables currently projected into SQLBot metadata for a datasource.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'choose_tables', 'description': 'Replace selected table projection for a SQL-type datasource. Conf-owned types re-project from conf instead. Requires ws admin.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}, 'tables': {'description': 'JSON array of tables to select, e.g. [{"table_name":"t1","table_comment":""},...]', 'type': 'string'}}, 'required': ['ds_id', 'tables'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_catalog_fields', 'description': 'Read-only: list remote catalog fields for a table name.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}, 'table_name': {'description': 'Remote catalog table name', 'type': 'string'}}, 'required': ['ds_id', 'table_name'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_table_fields', 'description': 'List fields stored in SQLBot metadata for a CoreTable id.', 'parameters': {'properties': {'table_id': {'description': 'CoreTable id', 'type': 'integer'}, 'field_name': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Optional field name filter'}}, 'required': ['table_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'update_table_meta', 'description': 'Update checked / custom_comment on a CoreTable. Requires ws admin.', 'parameters': {'properties': {'table_id': {'description': 'CoreTable id', 'type': 'integer'}, 'checked': {'anyOf': [{'type': 'boolean'}, {'type': 'null'}], 'default': None, 'description': 'Whether the table is selected/enabled'}, 'custom_comment': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Custom comment stored in SQLBot'}}, 'required': ['table_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'update_field_meta', 'description': 'Update checked / custom_comment on a CoreField. Requires ws admin.', 'parameters': {'properties': {'field_id': {'description': 'CoreField id', 'type': 'integer'}, 'checked': {'anyOf': [{'type': 'boolean'}, {'type': 'null'}], 'default': None, 'description': 'Whether the field is selected/enabled'}, 'custom_comment': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Custom comment stored in SQLBot'}}, 'required': ['field_id'], 'type': 'object'}}}]}}
