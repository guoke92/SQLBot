ta[].projectName) — 项目名称\n    - data[].projectType (string path=data[].projectType) — 项目类型\n    - data[].realAvailChargeAmount (number path=data[].realAvailChargeAmount) — 已发生可收费规模\n    - data[].revenueDiffAmount (number path=data[].revenueDiffAmount) — 收入差异金额\n    - data[].revenueDiffReason (string path=data[].revenueDiffReason) — 收入差异原因\n    - data[].revenueYearDiffReason (string path=data[].revenueYearDiffReason) — 年初收入预算差异原因\n    - data[].thirdChannelFee (number path=data[].thirdChannelFee) — 返润（渠道）（万）\n    - data[].weekAvailChargeAmount (number path=data[].weekAvailChargeAmount) — 本周可收费规模\n    - data[].weekTotalRevenue (number path=data[].weekTotalRevenue) — 本周收入\n    - data[].yearForecastAvailChargeAmount (number path=data[].yearForecastAvailChargeAmount) — 年初月可收费规模预测\n    - data[].yearForecastMonthRevenue (number path=data[].yearForecastMonthRevenue) — 年初月收入预测\n    - message (string path=message)\n    - traceId (string path=traceId)\n    - url (string path=url)\n\n</api-schema>\n### 附加说明:\n\n\n### 当前时间:\n2026-07-16 10:02:57\n', 'role': 'user'}], 'model': 'xiaomi/mimo-v2.5-pro', 'stream': True, 'stream_options': {'include_usage': True}, 'temperature': 0.7}}
