k_deleted_project, 周预测已删除项目记录表（用于过滤DW同步数据）\n[\n(id:bigint),\n(project_type:varchar, 项目类型),\n(business_type:varchar, 业务类型),\n(group_name:varchar, 归属团队),\n(delete_user:varchar, 删除人),\n(delete_week_end_date:varchar, 删除时所在周期),\n(project_name:varchar, 项目名称),\n(product_type:varchar, 产品类型),\n(center_name:varchar, 归属中心),\n(capital:varchar, 资方),\n(delete_time:datetime, 删除时间)\n]\n# Table: zhanke_revenue_week_forecast_record, 战客项目周预测轮次记录表\n[\n(forecast_id:int, 预测记录编号),\n(project_end_month:varchar, 项目截止月份),\n(forecast_end_date:varchar, 预测结束日期),\n(create_time:varchar, 新建时间),\n(project_start_month:varchar, 项目起始月份),\n(forecast_start_date:varchar, 预测起始日期),\n(last_edit_user:varchar, 最后修改用户),\n(update_time:varchar, 修改时间)\n]\n# Table: zhanke_project_revenue_forecast_week_test, 战客项目预测流水记录表\n[\n(project_name:varchar, 项目名称),\n(forecast_month:varchar, 项目月份),\n(week_avail_charge_amount:decimal, 本周可收费规模),\n(diff_reason:varchar, 差额原因),\n(group_name:varchar, 归属团队),\n(create_time:varchar, 新建时间),\n(week_total_revenue:decimal, 周预测收入),\n(revenue_diff_reason:varchar, 利润差异原因),\n(project_week_id:int, 编号),\n(project_type:varchar, 项目类型),\n(forecast_week_end_date:varchar, 项目周记录日),\n(diff_amount:decimal, 差额),\n(center_name:varchar, 归属中心),\n(last_edit_user:varchar, 最后修改用户),\n(update_time:varchar, 修改时间),\n(revenue_diff_amount:varchar, 收入差异金额),\n(revenue_year_diff_reason:varchar, 年初收入预算差异原因)\n]\n# Table: zhanke_revenue_cust_and_fee_month\n[\n(center_name:varchar, 中心),\n(statics_year:varchar, 年份),\n(market_dev_fee_gifts:decimal, 市场拓展费-礼品),\n(travel_expenses:decimal, 差旅费),\n(ams_new_add_cust_cnt:bigint, 投行类新增有收入核心企业客户数),\n(fintech_new_add_org_cnt:bigint, 金融科技类新落地金融机构客户数),\n(create_time:datetime, 创建时间),\n(id:bigint),\n(group_name:varchar, 归属团队),\n(statics_month:varchar, 月份),\n(business_expenses:decimal, 业务招待费),\n(tendering_service_fee:decimal, 招标服务费),\n(fintech_new_add_cust_cnt:bigint, 金融科技类新落地核心企业客户数),\n(last_edit_user:varchar, 最后修改用户),\n(update_time:datetime, 更新时间)\n]\n# Table: zhanke_project_revenue_foreca