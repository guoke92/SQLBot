'description': 'Datasource id', 'type': 'integer'}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_catalog_tables', 'description': 'Read-only: list remote catalog tables for a datasource.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_selected_tables', 'description': 'List tables currently projected into SQLBot metadata for a datasource.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}}, 'required': ['ds_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'choose_tables', 'description': 'Update SQL-type datasource table projection. mode="add" (default) merges tables into current selection; mode="remove" drops named tables; mode="set" fully replaces selection with the input list. Conf-owned types re-project from conf instead. Requires ws admin.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}, 'tables': {'description': 'JSON array of tables involved in the operation, e.g. [{"table_name":"t1","table_comment":""},...]', 'type': 'string'}, 'mode': {'default': 'add', 'description': 'Projection mode: "add" (default) merges tables into current selection; "remove" drops named tables from current selection; "set" replaces the entire selection with the input list. Never pass mode="set" with only newly added names — that deletes the rest.', 'type': 'string'}}, 'required': ['ds_id', 'tables'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_catalog_fields', 'description': 'Read-only: list remote catalog fields for a table name.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}, 'table_name': {'description': 'Remote catalog table name', 'type': 'string'}}, 'required': ['ds_id', 'table_name'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'list_table_fields', 'description': 'List fields stored in SQLBot metadata for a CoreTable id.', 'parameters': {'properties': {'table_id': {'description': 'CoreTable id', 'type': 'integer'}, 'field_name': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Optional field name filter'}}, 'required': ['table_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'update_table_meta', 'description': 'Update checked / custom_comment on a CoreTable. Requires ws admin.', 'parameters': {'properties': {'table_id': {'description': 'CoreTable id', 'type': 'integer'}, 'checked': {'anyOf': [{'type': 'boolean'}, {'type': 'null'}], 'default': None, 'description': 'Whether the table is selected/enabled'}, 'custom_comment': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Custom comment stored in SQLBot'}}, 'required': ['table_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'update_field_meta', 'description': 'Update checked / custom_comment on a CoreField. Requires ws admin.', 'parameters': {'properties': {'field_id': {'description': 'CoreField id', 'type': 'integer'}, 'checked': {'anyOf': [{'type': 'boolean'}, {'type': 'null'}], 'default': None, 'description': 'Whether the field is selected/enabled'}, 'custom_comment': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Custom comment stored in SQLBot'}}, 'required': ['field_id'], 'type': 'object'}}}, {'type': 'function', 'function': {'name': 'get_sample_data', 'description': 'Protocol-level sample preview (max 3 rows x 10 fields) for an already projected table via CAP_SAMPLE_DATA. Not free SQL and not a chart pipeline. Use to validate projection; chart analysis belongs in the main NLQ chat.', 'parameters': {'properties': {'ds_id': {'description': 'Datasource id', 'type': 'integer'}, 'table_name': {'description': 'Already-projected table name (must exist as CoreTable under the datasource). Protocol-level sample only — not free SQL.', 'type': 'string'}}, 'required': ['ds_id', 'table_name'], 'type': 'object'}}}]}}
