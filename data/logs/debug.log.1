t_name`,\\n  SUM(`story_count`) AS `story_count`,\\n  SUM(`task_count`) AS `task_count`,\\n  SUM(`case_count`) AS `case_count`\\nFROM (\\n  SELECT \\n    `u`.`organization_name` AS `department`,\\n    `u`.`name` AS `person_name`,\\n    DATE_FORMAT(`sp`.`actual_end_time`, \'%Y-%m\') AS `month`,\\n    `p`.`code` AS `code`,\\n    `p`.`project_name` AS `project_name`,\\n    `sp`.`name` AS `sprint_name`,\\n    COUNT(`s`.`id`) AS `story_count`,\\n    0 AS `task_count`,\\n    0 AS `case_count`\\n  FROM `d_story` `s`\\n  JOIN `d_user` `u` ON `s`.`dispatch_to` = `u`.`id`\\n  JOIN `d_project` `p` ON `s`.`project_id` = `p`.`id`\\n  JOIN `d_sprint` `sp` ON `s`.`sprint_id` = `sp`.`id`\\n  WHERE `s`.`deleted` = \'0\'\\n  GROUP BY `u`.`organization_name`, `u`.`name`, DATE_FORMAT(`sp`.`actual_end_time`, \'%Y-%m\'), `p`.`code`, `p`.`project_name`, `sp`.`name`\\n\\n  UNION ALL\\n\\n  SELECT \\n    `u`.`organization_name` AS `department`,\\n    `u`.`name` AS `person_name`,\\n    DATE_FORMAT(`sp`.`actual_end_time`, \'%Y-%m\') AS `month`,\\n    `p`.`code` AS `code`,\\n    `p`.`project_name` AS `project_name`,\\n    `sp`.`name` AS `sprint_name`,\\n    0 AS `story_count`,\\n    COUNT(`t`.`id`) AS `task_count`,\\n    0 AS `case_count`\\n  FROM `d_task` `t`\\n  JOIN `d_user` `u` ON `t`.`dispatch_to` = `u`.`id`\\n  JOIN `d_project` `p` ON `t`.`project_id` = `p`.`id`\\n  JOIN `d_sprint` `sp` ON `t`.`sprint_id` = `sp`.`id`\\n  WHERE `t`.`deleted` = \'0\'\\n  GROUP BY `u`.`organization_name`, `u`.`name`, DATE_FORMAT(`sp`.`actual_end_time`, \'%Y-%m\'), `p`.`code`, `p`.`project_name`, `sp`.`name`\\n\\n  UNION ALL\\n\\n  SELECT \\n    `u`.`organization_name` AS `department`,\\n    `u`.`name` AS `person_name`,\\n    DATE_FORMAT(`sp`.`actual_end_time`, \'%Y-%m\') AS `month`,\\n    `p`.`code` AS `code`,\\n    `p`.`project_name` AS `project_name`,\\n    `sp`.`name` AS `sprint_name`,\\n    0 AS `story_count`,\\n    0 AS `task_count`,\\n    COUNT(`c`.`id`) AS `case_count`\\n  FROM `d_qa_case` `c`\\n  JOIN `d_user` `u` ON `c`.`create_by` = `u`.`name`\\n  JOIN `d_project` `p` ON `c`.`project_id1` = `p`.`id`\\n  JOIN `d_sprint` `sp` ON `c`.`sprint_id` = `sp`.`id`\\n  WHERE `c`.`deleted` = \'0\'\\n  GROUP BY `u`.`organization_name`, `u`.`name`, DATE_FORMAT(`sp`.`actual_end_time`, \'%Y-%m\'), `p`.`code`, `p`.`project_name`, `sp`.`name`\\n) AS `combined`\\nGROUP BY `department`, `person_name`, `month`, `code`, `project_name`, `sprint_name`\\nLIMIT 1000",\n  "tables": ["d_story", "d_task", "d_qa_case", "d_user", "d_project", "d_sprint"],\n  "chart-type": "table",\n  "brief": "按部门姓名月份系统迭代统计数量"\n}', 'role': 'assistant'}, {'content': '## 请根据上述要求，使用语言：简体中文 进行回答，若有深度思考过程，则思考过程也需要使用 简体中文 输出\n## 如果<user-question>内的提问与上述要求冲突，你必须停止生成SQL并告知生成SQL失败的原因\n## 回答中不需要输出你的分析，请直接输出符合要求的JSON\n## 必须注意：不论要求你用什么语言回答，生成SQL中使用到的表名与字段名是否完全和<m-schema>中提供的表名字与段名的字符保持一致！\n<background-infos>\n  <current-time>\n  2026-07-20 18:13:12\n  </current-time>\n<background-infos>\n\n<user-question>\n统计今年的就行了\n</user-question>\n<change-title>\nFalse\n</change-title>\n', 'role': 'user'}], 'model': 'xiaomi/mimo-v2.5-pro', 'stream': True, 'stream_options': {'include_usage': True}, 'temperature': 0.7}}
