n   AND `c03`.`deleted` = \'0\'\n   JOIN `d_user` `u03` ON `r03`.`test_by` = `u03`.`name`\n   LEFT JOIN `d_sprint` `s03` ON `c03`.`sprint_id` = `s03`.`id`\n   AND `s03`.`deleted` = \'0\'\n   LEFT JOIN `d_project` `p03` ON `c03`.`project_id1` = `p03`.`id`\n   WHERE `c03`.`deleted` = \'0\'\n     AND YEAR(`s03`.`actual_end_time`) = 2026\n   GROUP BY `u03`.`name`,\n            `u03`.`organization_name`,\n            DATE_FORMAT(`s03`.`actual_end_time`, \'%Y-%m\'),\n            `p03`.`code`,\n            `p03`.`project_name`,\n            `s03`.`name`) `t`\nGROUP BY `t`.`person_name`,\n         `t`.`org_name`,\n         `t`.`year_month`,\n         `t`.`code`,\n         `t`.`project_name`,\n         `t`.`sprint_name`\nLIMIT 1000\n</sql>\n<m-schema>\n【DB_ID】 aio20240430\n【Schema】\n# Table: d_user, 用户信息表，name为姓名（关联story/task/qa_result中的人员），org为所属组织ID（关联d_organization.id）\n[\n(org:bigint, 机构ID),\n(name:varchar, 姓名),\n(related_bus_id:decimal, 关联业务id),\n(phone:varchar, 电话),\n(last_login_time:datetime, 最后登录时间),\n(enable:decimal, 是否有效，0无效，1有效),\n(create_by:varchar, 创建人),\n(organization_name:varchar, 机构名称),\n(table_head:text, 用户行为-表头),\n(company_name:varchar, 企业名称),\n(valid_date:date, 密码生效日期),\n(wc_job_id:varchar, 企微用户工号),\n(wc_depart:varchar, 企微全部部门id),\n(direct_leader_id:bigint, 用户直属领导ID),\n(new_direct_leader_id:bigint, 用户新直属领导ID),\n(user_name:varchar, 用户名),\n(user_type:varchar, 用户类型(管理员等)),\n(status:varchar, 状态),\n(email:varchar, 邮箱),\n(last_login_ip:varchar, 最后登录ip),\n(remark:text, 备注),\n(update_time:datetime, 更新时间),\n(profile_picture:longtext, 头像),\n(select_item:text, 用户行为-筛选项),\n(company_id:bigint, 企业ID),\n(is_ldap_user:varchar, 是否ldap用户，1：是，0否),\n(is_leader:tinyint, 是否部门负责人，1-是，0-否),\n(wc_create_date:date, 企微账户创建日期),\n(need_report_workload:tinyint, 是否需要报工，默认为不需要),\n(id:bigint, 主键id),\n(password:varchar, 密码(md5加密)),\n(business_type:varchar, 用户业务类型(供应商,网关,资金方,核心企业)),\n(ldap_status:varchar, 域账号状态),\n(login_fail_count:decimal, 登录失败次数),\n(locked_time:datetime, 锁定时间),\n(create_time:datetime, 创建时间),\n(update_by:varchar, 更新人),\n(position:varchar, 职位),\n(deleted:varchar, 删除状态，0-未删除，1-已删除),\n(invalid_date:date, 密码失效日期),\n(wc_id:varchar, 企微组织ID),\n(wc_main_depart:int, 企微主部门id),\n(wc_remove_date:date, 企微账户删除日期),\n(need_report_ka_workload:tinyint, 是否需要报工，默认为不需要)\n]\n# Table: d_story, Story表，关联项目(project_id)和迭代(sprint_id)，dispatch_to_name为负责开发人员，deleted为删除标记\n[\n(id:bigint, 主键),\n(tag_name:varchar, 层级名称),\n(parent_id:bigint, 父级id),\n(project_id:bigint, 所属项目id),\n(title:varchar, 标题),\n(content:longtext, 主体内容),\n(business_rule_description:longtext, 业务规则描述),\n(modify_reason:text, 关联改造说明),\n(other_support_info:text, 其它支撑信息),\n(accept_condition:longtext, 验收条件),\n(prototype_url:varchar, 原型地址),\n(product_manager:varchar, 产品经理),\n(dispatch_to:bigint, 被分配人),\n(dispatch_to_name:varchar, 被分配人名称),\n(test_person:varchar, 测试负责人),\n(status:varchar, 状态),\n(priority:varchar, 优先级),\n(sprint_id:bigint, 迭代表id),\n(plan_workload:decimal, 预估工作量),\n(plan_workload_frontend:decimal, 预估前端工作量),\n(plan_workload_backend:decimal, 预估后端工作量),\n(plan_workload_test:decimal, 预估测试工作量),\n(plan_workload_other:decimal, 预估其他工作量),\n(actually_workload:decimal, 实际工作量),\n(plan_start_time:date, 计划开始时间),\n(plan_end_time:date, 计划结束时间),\n(actually_start_time:date, 实际开始时间),\n(actually_end_time:date, 实际待发布时间),\n(accepting_time:date, 转验收中时间),\n(create_by:varchar, 创建人),\n(last_update_by:varchar, 最后修改人),\n(create_time:datetime, 创建时间),\n(update_time:datetime, 修改时间),\n(graphical_requirement:longtext, 界面要求),\n(description:longtext, 描述信息),\n(bussiness_id:bigint, 关联业务需求),\n(product_id:bigint, 关联产品),\n(product_model_id:text, 关联产品模块),\n(deleted:varchar, 删除状态，0-有效，1-已删除),\n(item_no:varchar, 编号),\n(order_no:varchar, 提测单号),\n(test_status:varchar, story提测状态：WAIT_COMMITTED:待提交、AUDITING:审核中、PASS:通过、FAILED:未通过),\n(actual_to_test_date:date, 实际转测日期),\n(begin_smoke_test_date:date, 开始提测日期:story从【待转测】翻转到【转测中】的日期),\n(finish_coding_date:date, 开发完成日期:story从【开发中】翻转到【待转测】的日期),\n(design_approved_date:date, 设计评审通过日期),\n(review_approved_date:date, 需求评审通过日期),\n(plan_to_test_date:date, 计划转测日期),\n(current_dispatch_to:varchar, 当前处理人),\n(schedule:decimal, story进度(默认0)),\n(test_schedule:decimal, 测试进度(默认0)),\n(work_sheet_id:bigint, 关联工单ID),\n(actual_online_time:datetime, 实际上线时间),\n(requirement_change_id:bigint, 需求变更ID),\n(test_times:int, 提测次数),\n(review_conclusion:tinyint, 评审结论，0不通过,1 通过),\n(review_id:bigint, 需求评审d_requirement_review#id),\n(accept_conclusion:tinyint, 验收结论，0不通过,1 通过),\n(accept_remark:text, 验收意见),\n(referraled:tinyint, 是否已转审，0-否，1-是),\n(accepter:varchar, 验收人),\n(remark:text, 备注),\n(plain_content:longtext, 去除html标签的内容)\n]\n# Table: d_project, 项目表，id为项目ID，code为系统编码，project_name为系统名称\n[\n(id:bigint, 主键),\n(project_no:varchar, 项目编号),\n(project_name:varchar, 项目名称),\n(belong_line_ids:text, 所属业务条线，一级组织层级),\n(project_type:varchar, 项目分类),\n(business_type:varchar, 业务条线),\n(status:varchar, 项目状态),\n(priority:varchar, 优先级),\n(notify:varchar, 项目通知),\n(situation:varchar, 系统概况),\n(start_date:date, 计划开始时间),\n(deliver_date:date, 要求交付时间),\n(business_manager_name:text, 业务负责人),\n(product_manager_name:text, 产品经理),\n(test_owner_name:text, 测试负责人),\n(technical_manager_name:text, 技术负责人),\n(dev_name:text, 开发人员),\n(project_manager_name:text, 业务项目经理),\n(organization_id:bigint, 团队),\n(create_time:datetime, 创建时间),\n(create_by:varchar, 创建人),\n(update_time:datetime, 修改时间),\n(update_by:varchar, 修改人),\n(log_project:varchar, 项目日志调用链标识),\n(project_sponsor:varchar, 项目发起人),\n(code:varchar, 项目英文名),\n(k8s_cluster:varchar, 项目部署集群),\n(audit_status:varchar, 审批状态：WAIT_AUDIT:待审批,CREATED:已创建,ROLLBACK:已退回,REFUSE:已拒绝),\n(level:varchar, 项目等级：STRATEGY:战略,IMPORTANT:重要,COOPERATION:合作),\n(value_evaluation:longtext, 项目价值评估),\n(is_use_low_code:varchar, 是否使用低代码：1:是,0:否),\n(standard_product:varchar, 是否标准化产品：1:是,0:否),\n(standard_product_customised:varchar, 是否标品交付系统：1:是,0:否),\n(project_sample_name:varchar, 项目简称),\n(project_first_type:varchar, 项目大类),\n(project_second_type:varchar, 项目小类),\n(create_date:date, 创建日期),\n(audit_date:date, 申请日期),\n(audit_suggest:text, 审核意见),\n(pmo:varchar, IT-PM),\n(is_create_auto_test_project:varchar, 是否创建自动化测试平台项目),\n(project_progress:varchar, 项目进展),\n(it_staff_workload:varchar, IT工作量评估 单位人日),\n(proj_cost_evaluation:varchar, 成本评估 单位万元),\n(app_id:varchar),\n(business_requirement_names:text, 关联需求名称),\n(business_requirement_ids:text, 关联需求ID),\n(business_line_id:bigint, 业务条线,一级组织架构),\n(is_code_repository:tinyint, 是否已有代码仓库),\n(is_pass_structure_audit:varchar, 是否通过架构评审，0-未通过，1-通过),\n(framework_id:bigint, 关联架构评审),\n(system_time:datetime, 系统创建时间),\n(is_create_bc_service:varchar, 是否同步创建bc服务，0-不创建，1-创建),\n(tags:varchar, 标签-用于区分devops1.0还是devops2.0),\n(financial_code_id:varchar, 财务编码id),\n(version_template_id:bigint, 发布模板ID),\n(version_template_name:varchar, 发布模板名称),\n(performance_testing_sys:varchar, 是否是性能测试系统（0-否，1-是）),\n(performance_testing_sys_reason:varchar, 是否是性能测试系统原因),\n(send_survey:varchar, 是否发送问卷),\n(operation:text, 运维人员),\n(has_asset_loss_risk:tinyint, 涉及资损风险)\n]\n# Table: d_qa_result, 测试结果表，case_id关联用例(d_qa_case.id)，plan_id关联测试计划(d_qa_plan.plan_id)，test_by为用例执行人\n[\n(result_id:bigint, 详情id),\n(assign_to:varchar, 分配给),\n(test_by:varchar, 测试人),\n(deleted:varchar, 删除状态，0-未删除，1-已删除),\n(case_id:bigint, 用例id),\n(result:varchar, 测试结果：未开始-INIT,通过-PASSED,失败-FAILURE,阻塞-BLOCKED,跳过-SKIPPED),\n(test_time:datetime, 测试时间),\n(group_id:bigint, 所属分组id),\n(plan_id:bigint, 计划id),\n(actual_result:longtext, 测试结果：[{"step": "1、进入投资人管理，tab切换到agreement，点击termplate","expectResult": "1、进入agreement termplate页面","status": "通过","actualResult": "dsadssssssssssssxxxd"}]\'),\n(smoke_result:varchar, 冒烟测试结果：未开始-INIT,通过-PASSED,失败-FAILURE,阻塞-BLOCKED),\n(is_api_case:int, 是否接口测试案例：1-是，0-否)\n]\n# Table: d_qa_case, 测试用例表，id为用例ID，deleted为删除标记\n[\n(group_id:bigint, 所属分组id),\n(precondition:text, 前置条件),\n(expected_result:text, 预期结果),\n(auto_test_switch:int, 是否同步创建0否1是),\n(update_time:datetime, 修改时间),\n(deleted:varchar, 删除状态，0-未删除，1-已删除),\n(self_result:varchar, 自测结论：PASS:通过、FAILED:不通过),\n(sprint_id:bigint, 迭代id),\n(project_id1:bigint, 系统id),\n(id:bigint, 用例id),\n(priority:varchar, 优先级),\n(describe_type:int, 1文本描述 2步骤描述),\n(test_count:int, 测试次数),\n(create_time:datetime, 创建时间),\n(update_by:varchar, 修改人),\n(case_url:longtext, 接口测试url地址),\n(test_times:int, 提测次数),\n(test_type:varchar, 测试类型：sit,uat),\n(title:varchar, 用例标题),\n(story_id:bigint, 关联需求),\n(text_describe:text, 文本描述内容),\n(is_smoke:int, 是否冒烟用例0否1是),\n(create_by:varchar, 创建人),\n(item_no:varchar, 编号),\n(is_api_case:int, 是否接口测试案例：1-是，0-否),\n(smoke_result:varchar, 冒烟结论),\n(type:varchar, 所属用例库，全量用例库，回归用例库)\n]\n# Table: d_task, Task表，关联项目(project_id)和迭代(sprint_id)，dispatch_to_name为分配人，deleted为删除标记\n[\n(id:bigint, 主键),\n(project_id:bigint, 所属项目id),\n(task_description:longtext, 任务描述),\n(status:varchar, 状态),\n(plan_workload:decimal, 预估工作量),\n(plan_end_time:date, 计划结束时间),\n(create_by:varchar, 创建人),\n(update_time:datetime, 修改时间),\n(schedule:decimal, task进度(默认为0)),\n(tag_name:varchar, 层级名称),\n(title:varchar, 标题),\n(dispatch_to:bigint, 被分配人),\n(sprint_id:bigint, 迭代表id),\n(actually_workload:decimal, 实际工作量),\n(actually_start_time:date, 实际开始时间),\n(last_update_by:varchar, 最后修改人),\n(deleted:varchar, 删除状态，0-有效，1-已删除),\n(work_sheet_id:bigint, 关联工单ID),\n(parent_id:bigint, 父级id),\n(content:longtext, 主体内容),\n(dispatch_to_name:varchar, 被分配人名称),\n(priority:varchar, 优先级),\n(plan_start_time:date, 计划开始时间),\n(actually_end_time:date, 实际结束时间),\n(create_time:datetime, 创建时间),\n(item_no:varchar, 编号),\n(remark:text, 备注)\n]\n# Table: d_sprint, 迭代表，id为迭代ID，name为迭代名称，actual_end_time为实际结束时间（用于按月统计）\n[\n(project_id:bigint, 所属项目id),\n(dispatch_to:bigint, 被分配人名称),\n(test_responsible_people:varchar, 测试负责人),\n(back_ground:text, 背景及现状),\n(create_by:varchar, 创建人),\n(update_time:datetime, 修改时间),\n(deleted:varchar, 删除状态，0-有效，1-已删除),\n(cause_by:varchar, 进度异常原因),\n(sprint_capacity:double, 迭代容量),\n(send_survey:varchar, 是否发送问卷),\n(name:varchar, 名称),\n(dispatch_to_name:varchar, 被分配人名称),\n(start_time:date, 开始时间),\n(business_value:text, 业务实施价值),\n(last_update_by:varchar, 最后修改人),\n(actual_start_time:date, 实际开始日期),\n(product_responsible_people:varchar, 产品负责人),\n(pmo:varchar, pmo),\n(performance_testing_sprint:varchar, 是否是性能测试迭代（0-否，1-是）),\n(remark:text, 备注),\n(id:bigint, 主键),\n(status:varchar, 状态),\n(develop_responsible_people:varchar, 开发负责人),\n(end_time:date, 结束时间),\n(goal:text, 迭代目标),\n(create_time:datetime, 创建时间),\n(actual_end_time:date, 实际结束日期),\n(current_status:varchar, 当前进度状态),\n(is_auto_create_task_package:varchar, 自动创建关联任务包开关),\n(performance_testing_sprint_reason:varchar, 性能测试迭代原因),\n(financial_code_id:bigint, 关联财务编码id(纯bug迭代使用))\n]\n\n</m-schema>\n<chart-type>\ntable\n</chart-type>\n', 'role': 'user'}, {'content': '{"type":"table","title":"2026年工作量统计","columns":[{"name":"姓名","value":"person_name"},{"name":"部门","value":"org_name"},{"name":"月份","value":"year_month"},{"name":"系统编码","value":"code"},{"name":"系统名称","value":"project_name"},{"name":"迭代名称","value":"sprint_name"},{"name":"Story数","value":"story_count"},{"name":"Task数","value":"task_count"},{"name":"用例数","value":"case_count"}]}', 'role': 'assistant'}, {'content': '## 请根据上述要求，使用语言：简体中文 进行回答，若有深度思考过程，则思考过程也需要使用 简体中文 输出\n## 回答中不需要输出你的分析，请直接输出符合要求的JSON\n## 必须注意：不论要求你用什么语言回答，生成图表结构中的value字段内容必须与提供的SQL中提供的字段别名的字符保持一致！\n<user-question>\n你直接执行下这个sql\n\nSELECT\n    k.organization_name   AS 部门,\n    k.person_name         AS 姓名,\n    k.month               AS 月份,\n    k.code                AS 系统编码,\n    k.project_name        AS 系统名称,\n    k.sprint_name         AS 迭代名称,\n    IFNULL(ss.total_stories, 0) AS story数,\n    IFNULL(ts.total_tasks, 0)   AS task数,\n    IFNULL(cs.total_case, 0)    AS 案例数\nFROM (\n    /* 维度全集：story侧 + 任务侧 + 用例侧出现过的 (部门,姓名,项目,迭代,月) */\n    SELECT organization_name, person_name, code, project_id, project_name, sprint_id, sprint_name, month\n    FROM (\n        /* Story维度 - 使用dispatch_to_name作为开发人员，从d_user获取部门 */\n        SELECT DISTINCT\n            u_org.organization_name,\n            s.dispatch_to_name AS person_name,\n            a.code,\n            a.id   AS project_id,\n            a.project_name AS project_name,\n            d.id   AS sprint_id,\n            d.name AS sprint_name,\n            DATE_FORMAT(d.actual_end_time, \'%Y-%m\') AS month\n        FROM aio.d_story s\n        LEFT JOIN aio.d_project a ON a.id = s.project_id\n        LEFT JOIN aio.d_sprint d ON d.id = s.sprint_id\n        LEFT JOIN aio.d_user u ON u.name = s.dispatch_to_name\n        LEFT JOIN aio.d_organization u_org ON u_org.id = u.org\n        LEFT JOIN aio.d_organization_flat_detail u_org_flat ON u_org_flat.sub_org_id = u_org.id\n        WHERE s.deleted = \'0\'\n          AND d.actual_end_time IS NOT NULL\n          AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') >= \'2026-01-01\'\n          AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') <= \'2026-06-30\'\n          AND u_org_flat.org_name = \'技术研发中心\'\n          AND s.dispatch_to_name IS NOT NULL\n          AND s.dispatch_to_name != \'\'\n          AND u.org IS NOT NULL\n\n        UNION\n\n        /* Task维度 - 使用dispatch_to_name作为分配人，从d_user获取部门 */\n        SELECT DISTINCT\n            u_org.organization_name,\n            t.dispatch_to_name AS person_name,\n            a.code,\n            a.id   AS project_id,\n            a.project_name AS project_name,\n            d.id   AS sprint_id,\n            d.name AS sprint_name,\n            DATE_FORMAT(d.actual_end_time, \'%Y-%m\') AS month\n        FROM aio.d_task t\n        LEFT JOIN aio.d_project a ON a.id = t.project_id\n        LEFT JOIN aio.d_sprint d ON d.id = t.sprint_id\n        LEFT JOIN aio.d_user u ON u.name = t.dispatch_to_name\n        LEFT JOIN aio.d_organization u_org ON u_org.id = u.org\n        LEFT JOIN aio.d_organization_flat_detail u_org_flat ON u_org_flat.sub_org_id = u_org.id\n        WHERE t.deleted = \'0\'\n          AND d.actual_end_time IS NOT NULL\n          AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') >= \'2026-01-01\'\n          AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') <= \'2026-06-30\'\n          AND u_org_flat.org_name = \'技术研发中心\'\n          AND t.dispatch_to_name IS NOT NULL\n          AND t.dispatch_to_name != \'\'\n          AND u.org IS NOT NULL\n\n        UNION\n\n        /* Case维度 - 使用d_qa_result.test_by作为执行人，从d_user获取部门 */\n        SELECT DISTINCT\n            u_org.organization_name,\n            qr.test_by AS person_name,\n            a.code,\n            a.id   AS project_id,\n            a.project_name AS project_name,\n            d.id   AS sprint_id,\n            d.name AS sprint_name,\n            DATE_FORMAT(d.actual_end_time, \'%Y-%m\') AS month\n        FROM aio.d_qa_case qc\n        LEFT JOIN aio.d_qa_result qr ON qr.case_id = qc.id\n        LEFT JOIN aio.d_qa_plan p ON p.plan_id = qr.plan_id\n        LEFT JOIN aio.d_project a ON a.id = p.project_id\n        LEFT JOIN aio.d_sprint d ON d.id = p.sprint_id\n        LEFT JOIN aio.d_user u ON u.name = qr.test_by\n        LEFT JOIN aio.d_organization u_org ON u_org.id = u.org\n        LEFT JOIN aio.d_organization_flat_detail u_org_flat ON u_org_flat.sub_org_id = u_org.id\n        WHERE qc.deleted = \'0\'\n          AND d.actual_end_time IS NOT NULL\n          AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') >= \'2026-01-01\'\n          AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') <= \'2026-06-30\'\n          AND u_org_flat.org_name = \'技术研发中心\'\n          AND qr.test_by IS NOT NULL\n          AND qr.test_by != \'\'\n          AND u.org IS NOT NULL\n    ) u\n) k\nLEFT JOIN (\n    /* Story统计 - 按开发人员统计，从d_user获取部门 */\n    SELECT\n        u_org.organization_name,\n        s.dispatch_to_name AS person_name,\n        a.code,\n        a.id   AS project_id,\n        a.project_name AS project_name,\n        d.id   AS sprint_id,\n        d.name AS sprint_name,\n        DATE_FORMAT(d.actual_end_time, \'%Y-%m\') AS month,\n        COUNT(s.id) AS total_stories\n    FROM aio.d_story s\n    LEFT JOIN aio.d_project a ON a.id = s.project_id\n    LEFT JOIN aio.d_sprint d ON d.id = s.sprint_id\n    LEFT JOIN aio.d_user u ON u.name = s.dispatch_to_name\n    LEFT JOIN aio.d_organization u_org ON u_org.id = u.org\n    LEFT JOIN aio.d_organization_flat_detail u_org_flat ON u_org_flat.sub_org_id = u_org.id\n    WHERE s.deleted = \'0\'\n      AND d.actual_end_time IS NOT NULL\n      AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') >= \'2026-01-01\'\n      AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') <= \'2026-06-30\'\n      AND u_org_flat.org_name = \'技术研发中心\'\n      AND s.dispatch_to_name IS NOT NULL\n      AND s.dispatch_to_name != \'\'\n      AND u.org IS NOT NULL\n    GROUP BY u_org.organization_name, s.dispatch_to_name, a.id, a.project_name, d.id, d.name, DATE_FORMAT(d.actual_end_time, \'%Y-%m\')\n) ss ON ss.organization_name = k.organization_name\n    AND ss.person_name = k.person_name\n    AND ss.project_id = k.project_id\n    AND ss.sprint_id = k.sprint_id\n    AND ss.month = k.month\nLEFT JOIN (\n    /* Task统计 - 按分配人统计，从d_user获取部门 */\n    SELECT\n        u_org.organization_name,\n        t.dispatch_to_name AS person_name,\n        a.code,\n        a.id   AS project_id,\n        a.project_name AS project_name,\n        d.id   AS sprint_id,\n        d.name AS sprint_name,\n        DATE_FORMAT(d.actual_end_time, \'%Y-%m\') AS month,\n        COUNT(t.id) AS total_tasks\n    FROM aio.d_task t\n    LEFT JOIN aio.d_project a ON a.id = t.project_id\n    LEFT JOIN aio.d_sprint d ON d.id = t.sprint_id\n    LEFT JOIN aio.d_user u ON u.name = t.dispatch_to_name\n    LEFT JOIN aio.d_organization u_org ON u_org.id = u.org\n    LEFT JOIN aio.d_organization_flat_detail u_org_flat ON u_org_flat.sub_org_id = u_org.id\n    WHERE t.deleted = \'0\'\n      AND d.actual_end_time IS NOT NULL\n      AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') >= \'2026-01-01\'\n      AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') <= \'2026-06-30\'\n      AND u_org_flat.org_name = \'技术研发中心\'\n      AND t.dispatch_to_name IS NOT NULL\n      AND t.dispatch_to_name != \'\'\n      AND u.org IS NOT NULL\n    GROUP BY u_org.organization_name, t.dispatch_to_name, a.id, a.project_name, d.id, d.name, DATE_FORMAT(d.actual_end_time, \'%Y-%m\')\n) ts ON ts.organization_name = k.organization_name\n    AND ts.person_name = k.person_name\n    AND ts.project_id = k.project_id\n    AND ts.sprint_id = k.sprint_id\n    AND ts.month = k.month\nLEFT JOIN (\n    /* Case统计 - 按执行人统计，从d_user获取部门 */\n    SELECT\n        u_org.organization_name,\n        qr.test_by AS person_name,\n        a.code,\n        a.id   AS project_id,\n        a.project_name AS project_name,\n        d.id   AS sprint_id,\n        d.name AS sprint_name,\n        DATE_FORMAT(d.actual_end_time, \'%Y-%m\') AS month,\n        COUNT(DISTINCT qc.id) AS total_case\n    FROM aio.d_qa_case qc\n    LEFT JOIN aio.d_qa_result qr ON qr.case_id = qc.id\n    LEFT JOIN aio.d_qa_plan p ON p.plan_id = qr.plan_id\n    LEFT JOIN aio.d_project a ON a.id = p.project_id\n    LEFT JOIN aio.d_sprint d ON d.id = p.sprint_id\n    LEFT JOIN aio.d_user u ON u.name = qr.test_by\n    LEFT JOIN aio.d_organization u_org ON u_org.id = u.org\n    LEFT JOIN aio.d_organization_flat_detail u_org_flat ON u_org_flat.sub_org_id = u_org.id\n    WHERE qc.deleted = \'0\'\n      AND d.actual_end_time IS NOT NULL\n      AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') >= \'2026-01-01\'\n      AND DATE_FORMAT(d.actual_end_time, \'%Y-%m-%d\') <= \'2026-06-30\'\n      AND u_org_flat.org_name = \'技术研发中心\'\n      AND qr.test_by IS NOT NULL\n      AND qr.test_by != \'\'\n      AND u.org IS NOT NULL\n    GROUP BY u_org.organization_name, qr.test_by, a.id, a.project_name, d.id, d.name, DATE_FORMAT(d.actual_end_time, \'%Y-%m\')\n) cs ON cs.organization_name = k.organization_name\n    AND cs.person_name = k.person_name\n    AND cs.project_id = k.project_id\n    AND cs.sprint_id = k.sprint_id\n    AND cs.month = k.month\nORDER BY k.organization_name, k.code, k.sprint_id, k.person_name, k.month;\n</user-question>\n<sql>\nSELECT k.`organization_name` AS `部门`,\n       k.`person_name` AS `姓名`,\n       k.`month` AS `月份`,\n       k.`code` AS `系统编码`,\n       k.`project_name` AS `系统名称`,\n       k.`sprint_name` AS `迭代名称`,\n       IFNULL(ss.`total_stories`, 0) AS `story数`,\n       IFNULL(ts.`total_tasks`, 0) AS `task数`,\n       IFNULL(cs.`total_case`, 0) AS `案例数`\nFROM\n  (SELECT `organization_name`,\n          `person_name`,\n          `code`,\n          `project_id`,\n          `project_name`,\n          `sprint_id`,\n          `sprint_name`,\n          `month`\n   FROM\n     (SELECT DISTINCT u_org.`organization_name`,\n                      s.`dispatch_to_name` AS `person_name`,\n                      a.`code`,\n                      a.`id` AS `project_id`,\n                      a.`project_name` AS `project_name`,\n                      d.`id` AS `sprint_id`,\n                      d.`name` AS `sprint_name`,\n                      DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\') AS `month`\n      FROM `aio20240430`.`d_story` s\n      LEFT JOIN `aio20240430`.`d_project` a ON a.`id` = s.`project_id`\n      LEFT JOIN `aio20240430`.`d_sprint` d ON d.`id` = s.`sprint_id`\n      LEFT JOIN `aio20240430`.`d_user` u ON u.`name` = s.`dispatch_to_name`\n      LEFT JOIN `aio20240430`.`d_organization` u_org ON u_org.`id` = u.`org`\n      LEFT JOIN `aio20240430`.`d_organization_flat_detail` u_org_flat ON u_org_flat.`sub_org_id` = u_org.`id`\n      WHERE s.`deleted` = \'0\'\n        AND d.`actual_end_time` IS NOT NULL\n        AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') >= \'2026-01-01\'\n        AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') <= \'2026-06-30\'\n        AND u_org_flat.`org_name` = \'技术研发中心\'\n        AND s.`dispatch_to_name` IS NOT NULL\n        AND s.`dispatch_to_name` != \'\'\n        AND u.`org` IS NOT NULL\n      UNION SELECT DISTINCT u_org.`organization_name`,\n                            t.`dispatch_to_name` AS `person_name`,\n                            a.`code`,\n                            a.`id` AS `project_id`,\n                            a.`project_name` AS `project_name`,\n                            d.`id` AS `sprint_id`,\n                            d.`name` AS `sprint_name`,\n                            DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\') AS `month`\n      FROM `aio20240430`.`d_task` t\n      LEFT JOIN `aio20240430`.`d_project` a ON a.`id` = t.`project_id`\n      LEFT JOIN `aio20240430`.`d_sprint` d ON d.`id` = t.`sprint_id`\n      LEFT JOIN `aio20240430`.`d_user` u ON u.`name` = t.`dispatch_to_name`\n      LEFT JOIN `aio20240430`.`d_organization` u_org ON u_org.`id` = u.`org`\n      LEFT JOIN `aio20240430`.`d_organization_flat_detail` u_org_flat ON u_org_flat.`sub_org_id` = u_org.`id`\n      WHERE t.`deleted` = \'0\'\n        AND d.`actual_end_time` IS NOT NULL\n        AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') >= \'2026-01-01\'\n        AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') <= \'2026-06-30\'\n        AND u_org_flat.`org_name` = \'技术研发中心\'\n        AND t.`dispatch_to_name` IS NOT NULL\n        AND t.`dispatch_to_name` != \'\'\n        AND u.`org` IS NOT NULL\n      UNION SELECT DISTINCT u_org.`organization_name`,\n                            qr.`test_by` AS `person_name`,\n                            a.`code`,\n                            a.`id` AS `project_id`,\n                            a.`project_name` AS `project_name`,\n                            d.`id` AS `sprint_id`,\n                            d.`name` AS `sprint_name`,\n                            DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\') AS `month`\n      FROM `aio20240430`.`d_qa_case` qc\n      LEFT JOIN `aio20240430`.`d_qa_result` qr ON qr.`case_id` = qc.`id`\n      LEFT JOIN `aio20240430`.`d_qa_plan` p ON p.`plan_id` = qr.`plan_id`\n      LEFT JOIN `aio20240430`.`d_project` a ON a.`id` = p.`project_id`\n      LEFT JOIN `aio20240430`.`d_sprint` d ON d.`id` = p.`sprint_id`\n      LEFT JOIN `aio20240430`.`d_user` u ON u.`name` = qr.`test_by`\n      LEFT JOIN `aio20240430`.`d_organization` u_org ON u_org.`id` = u.`org`\n      LEFT JOIN `aio20240430`.`d_organization_flat_detail` u_org_flat ON u_org_flat.`sub_org_id` = u_org.`id`\n      WHERE qc.`deleted` = \'0\'\n        AND d.`actual_end_time` IS NOT NULL\n        AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') >= \'2026-01-01\'\n        AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') <= \'2026-06-30\'\n        AND u_org_flat.`org_name` = \'技术研发中心\'\n        AND qr.`test_by` IS NOT NULL\n        AND qr.`test_by` != \'\'\n        AND u.`org` IS NOT NULL) u) k\nLEFT JOIN\n  (SELECT u_org.`organization_name`,\n          s.`dispatch_to_name` AS `person_name`,\n          a.`code`,\n          a.`id` AS `project_id`,\n          a.`project_name` AS `project_name`,\n          d.`id` AS `sprint_id`,\n          d.`name` AS `sprint_name`,\n          DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\') AS `month`,\n          COUNT(s.`id`) AS `total_stories`\n   FROM `aio20240430`.`d_story` s\n   LEFT JOIN `aio20240430`.`d_project` a ON a.`id` = s.`project_id`\n   LEFT JOIN `aio20240430`.`d_sprint` d ON d.`id` = s.`sprint_id`\n   LEFT JOIN `aio20240430`.`d_user` u ON u.`name` = s.`dispatch_to_name`\n   LEFT JOIN `aio20240430`.`d_organization` u_org ON u_org.`id` = u.`org`\n   LEFT JOIN `aio20240430`.`d_organization_flat_detail` u_org_flat ON u_org_flat.`sub_org_id` = u_org.`id`\n   WHERE s.`deleted` = \'0\'\n     AND d.`actual_end_time` IS NOT NULL\n     AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') >= \'2026-01-01\'\n     AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') <= \'2026-06-30\'\n     AND u_org_flat.`org_name` = \'技术研发中心\'\n     AND s.`dispatch_to_name` IS NOT NULL\n     AND s.`dispatch_to_name` != \'\'\n     AND u.`org` IS NOT NULL\n   GROUP BY u_org.`organization_name`,\n            s.`dispatch_to_name`,\n            a.`id`,\n            a.`project_name`,\n            d.`id`,\n            d.`name`,\n            DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\')) ss ON ss.`organization_name` = k.`organization_name`\nAND ss.`person_name` = k.`person_name`\nAND ss.`project_id` = k.`project_id`\nAND ss.`sprint_id` = k.`sprint_id`\nAND ss.`month` = k.`month`\nLEFT JOIN\n  (SELECT u_org.`organization_name`,\n          t.`dispatch_to_name` AS `person_name`,\n          a.`code`,\n          a.`id` AS `project_id`,\n          a.`project_name` AS `project_name`,\n          d.`id` AS `sprint_id`,\n          d.`name` AS `sprint_name`,\n          DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\') AS `month`,\n          COUNT(t.`id`) AS `total_tasks`\n   FROM `aio20240430`.`d_task` t\n   LEFT JOIN `aio20240430`.`d_project` a ON a.`id` = t.`project_id`\n   LEFT JOIN `aio20240430`.`d_sprint` d ON d.`id` = t.`sprint_id`\n   LEFT JOIN `aio20240430`.`d_user` u ON u.`name` = t.`dispatch_to_name`\n   LEFT JOIN `aio20240430`.`d_organization` u_org ON u_org.`id` = u.`org`\n   LEFT JOIN `aio20240430`.`d_organization_flat_detail` u_org_flat ON u_org_flat.`sub_org_id` = u_org.`id`\n   WHERE t.`deleted` = \'0\'\n     AND d.`actual_end_time` IS NOT NULL\n     AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') >= \'2026-01-01\'\n     AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') <= \'2026-06-30\'\n     AND u_org_flat.`org_name` = \'技术研发中心\'\n     AND t.`dispatch_to_name` IS NOT NULL\n     AND t.`dispatch_to_name` != \'\'\n     AND u.`org` IS NOT NULL\n   GROUP BY u_org.`organization_name`,\n            t.`dispatch_to_name`,\n            a.`id`,\n            a.`project_name`,\n            d.`id`,\n            d.`name`,\n            DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\')) ts ON ts.`organization_name` = k.`organization_name`\nAND ts.`person_name` = k.`person_name`\nAND ts.`project_id` = k.`project_id`\nAND ts.`sprint_id` = k.`sprint_id`\nAND ts.`month` = k.`month`\nLEFT JOIN\n  (SELECT u_org.`organization_name`,\n          qr.`test_by` AS `person_name`,\n          a.`code`,\n          a.`id` AS `project_id`,\n          a.`project_name` AS `project_name`,\n          d.`id` AS `sprint_id`,\n          d.`name` AS `sprint_name`,\n          DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\') AS `month`,\n          COUNT(DISTINCT qc.`id`) AS `total_case`\n   FROM `aio20240430`.`d_qa_case` qc\n   LEFT JOIN `aio20240430`.`d_qa_result` qr ON qr.`case_id` = qc.`id`\n   LEFT JOIN `aio20240430`.`d_qa_plan` p ON p.`plan_id` = qr.`plan_id`\n   LEFT JOIN `aio20240430`.`d_project` a ON a.`id` = p.`project_id`\n   LEFT JOIN `aio20240430`.`d_sprint` d ON d.`id` = p.`sprint_id`\n   LEFT JOIN `aio20240430`.`d_user` u ON u.`name` = qr.`test_by`\n   LEFT JOIN `aio20240430`.`d_organization` u_org ON u_org.`id` = u.`org`\n   LEFT JOIN `aio20240430`.`d_organization_flat_detail` u_org_flat ON u_org_flat.`sub_org_id` = u_org.`id`\n   WHERE qc.`deleted` = \'0\'\n     AND d.`actual_end_time` IS NOT NULL\n     AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') >= \'2026-01-01\'\n     AND DATE_FORMAT(d.`actual_end_time`, \'%Y-%m-%d\') <= \'2026-06-30\'\n     AND u_org_flat.`org_name` = \'技术研发中心\'\n     AND qr.`test_by` IS NOT NULL\n     AND qr.`test_by` != \'\'\n     AND u.`org` IS NOT NULL\n   GROUP BY u_org.`organization_name`,\n            qr.`test_by`,\n            a.`id`,\n            a.`project_name`,\n            d.`id`,\n            d.`name`,\n            DATE_FORMAT(d.`actual_end_time`, \'%Y-%m\')) cs ON cs.`organization_name` = k.`organization_name`\nAND cs.`person_name` = k.`person_name`\nAND cs.`project_id` = k.`project_id`\nAND cs.`sprint_id` = k.`sprint_id`\nAND cs.`month` = k.`month`\nORDER BY k.`organization_name`,\n         k.`code`,\n         k.`sprint_id`,\n         k.`person_name`,\n         k.`month`\nLIMIT 1000\n</sql>\n<m-schema>\n【DB_ID】 aio20240430\n【Schema】\n# Table: d_qa_result, 测试结果表，case_id关联用例(d_qa_case.id)，plan_id关联测试计划(d_qa_plan.plan_id)，test_by为用例执行人\n[\n(result_id:bigint, 详情id),\n(assign_to:varchar, 分配给),\n(test_by:varchar, 测试人),\n(deleted:varchar, 删除状态，0-未删除，1-已删除),\n(case_id:bigint, 用例id),\n(result:varchar, 测试结果：未开始-INIT,通过-PASSED,失败-FAILURE,阻塞-BLOCKED,跳过-SKIPPED),\n(test_time:datetime, 测试时间),\n(group_id:bigint, 所属分组id),\n(plan_id:bigint, 计划id),\n(actual_result:longtext, 测试结果：[{"step": "1、进入投资人管理，tab切换到agreement，点击termplate","expectResult": "1、进入agreement termplate页面","status": "通过","actualResult": "dsadssssssssssssxxxd"}]\'),\n(smoke_result:varchar, 冒烟测试结果：未开始-INIT,通过-PASSED,失败-FAILURE,阻塞-BLOCKED),\n(is_api_case:int, 是否接口测试案例：1-是，0-否)\n]\n# Table: d_qa_case, 测试用例表，id为用例ID，deleted为删除标记\n[\n(group_id:bigint, 所属分组id),\n(precondition:text, 前置条件),\n(expected_result:text, 预期结果),\n(auto_test_switch:int, 是否同步创建0否1是),\n(update_time:datetime, 修改时间),\n(deleted:varchar, 删除状态，0-未删除，1-已删除),\n(self_result:varchar, 自测结论：PASS:通过、FAILED:不通过),\n(sprint_id:bigint, 迭代id),\n(project_id1:bigint, 系统id),\n(id:bigint, 用例id),\n(priority:varchar, 优先级),\n(describe_type:int, 1文本描述 2步骤描述),\n(test_count:int, 测试次数),\n(create_time:datetime, 创建时间),\n(update_by:varchar, 修改人),\n(case_url:longtext, 接口测试url地址),\n(test_times:int, 提测次数),\n(test_type:varchar, 测试类型：sit,uat),\n(title:varchar, 用例标题),\n(story_id:bigint, 关联需求),\n(text_describe:text, 文本描述内容),\n(is_smoke:int, 是否冒烟用例0否1是),\n(create_by:varchar, 创建人),\n(item_no:varchar, 编号),\n(is_api_case:int, 是否接口测试案例：1-是，0-否),\n(smoke_result:varchar, 冒烟结论),\n(type:varchar, 所属用例库，全量用例库，回归用例库)\n]\n# Table: d_task, Task表，关联项目(project_id)和迭代(sprint_id)，dispatch_to_name为分配人，deleted为删除标记\n[\n(id:bigint, 主键),\n(project_id:bigint, 所属项目id),\n(task_description:longtext, 任务描述),\n(status:varchar, 状态),\n(plan_workload:decimal, 预估工作量),\n(plan_end_time:date, 计划结束时间),\n(create_by:varchar, 创建人),\n(update_time:datetime, 修改时间),\n(schedule:decimal, task进度(默认为0)),\n(tag_name:varchar, 层级名称),\n(title:varchar, 标题),\n(dispatch_to:bigint, 被分配人),\n(sprint_id:bigint, 迭代表id),\n(actually_workload:decimal, 实际工作量),\n(actually_start_time:date, 实际开始时间),\n(last_update_by:varchar, 最后修改人),\n(deleted:varchar, 删除状态，0-有效，1-已删除),\n(work_sheet_id:bigint, 关联工单ID),\n(parent_id:bigint, 父级id),\n(content:longtext, 主体内容),\n(dispatch_to_name:varchar, 被分配人名称),\n(priority:varchar, 优先级),\n(plan_start_time:date, 计划开始时间),\n(actually_end_time:date, 实际结束时间),\n(create_time:datetime, 创建时间),\n(item_no:varchar, 编号),\n(remark:text, 备注)\n]\n# Table: d_story, Story表，关联项目(project_id)和迭代(sprint_id)，dispatch_to_name为负责开发人员，deleted为删除标记\n[\n(id:bigint, 主键),\n(tag_name:varchar, 层级名称),\n(parent_id:bigint, 父级id),\n(project_id:bigint, 所属项目id),\n(title:varchar, 标题),\n(content:longtext, 主体内容),\n(business_rule_description:longtext, 业务规则描述),\n(modify_reason:text, 关联改造说明),\n(other_support_info:text, 其它支撑信息),\n(accept_condition:longtext, 验收条件),\n(prototype_url:varchar, 原型地址),\n(product_manager:varchar, 产品经理),\n(dispatch_to:bigint, 被分配人),\n(dispatch_to_name:varchar, 被分配人名称),\n(test_person:varchar, 测试负责人),\n(status:varchar, 状态),\n(priority:varchar, 优先级),\n(sprint_id:bigint, 迭代表id),\n(plan_workload:decimal, 预估工作量),\n(plan_workload_frontend:decimal, 预估前端工作量),\n(plan_workload_backend:decimal, 预估后端工作量),\n(plan_workload_test:decimal, 预估测试工作量),\n(plan_workload_other:decimal, 预估其他工作量),\n(actually_workload:decimal, 实际工作量),\n(plan_start_time:date, 计划开始时间),\n(plan_end_time:date, 计划结束时间),\n(actually_start_time:date, 实际开始时间),\n(actually_end_time:date, 实际待发布时间),\n(accepting_time:date, 转验收中时间),\n(create_by:varchar, 创建人),\n(last_update_by:varchar, 最后修改人),\n(create_time:datetime, 创建时间),\n(update_time:datetime, 修改时间),\n(graphical_requirement:longtext, 界面要求),\n(description:longtext, 描述信息),\n(bussiness_id:bigint, 关联业务需求),\n(product_id:bigint, 关联产品),\n(product_model_id:text, 关联产品模块),\n(deleted:varchar, 删除状态，0-有效，1-已删除),\n(item_no:varchar, 编号),\n(order_no:varchar, 提测单号),\n(test_status:varchar, story提测状态：WAIT_COMMITTED:待提交、AUDITING:审核中、PASS:通过、FAILED:未通过),\n(actual_to_test_date:date, 实际转测日期),\n(begin_smoke_test_date:date, 开始提测日期:story从【待转测】翻转到【转测中】的日期),\n(finish_coding_date:date, 开发完成日期:story从【开发中】翻转到【待转测】的日期),\n(design_approved_date:date, 设计评审通过日期),\n(review_approved_date:date, 需求评审通过日期),\n(plan_to_test_date:date, 计划转测日期),\n(current_dispatch_to:varchar, 当前处理人),\n(schedule:decimal, story进度(默认0)),\n(test_schedule:decimal, 测试进度(默认0)),\n(work_sheet_id:bigint, 关联工单ID),\n(actual_online_time:datetime, 实际上线时间),\n(requirement_change_id:bigint, 需求变更ID),\n(test_times:int, 提测次数),\n(review_conclusion:tinyint, 评审结论，0不通过,1 通过),\n(review_id:bigint, 需求评审d_requirement_review#id),\n(accept_conclusion:tinyint, 验收结论，0不通过,1 通过),\n(accept_remark:text, 验收意见),\n(referraled:tinyint, 是否已转审，0-否，1-是),\n(accepter:varchar, 验收人),\n(remark:text, 备注),\n(plain_content:longtext, 去除html标签的内容)\n]\n# Table: d_sprint, 迭代表，id为迭代ID，name为迭代名称，actual_end_time为实际结束时间（用于按月统计）\n[\n(project_id:bigint, 所属项目id),\n(dispatch_to:bigint, 被分配人名称),\n(test_responsible_people:varchar, 测试负责人),\n(back_ground:text, 背景及现状),\n(create_by:varchar, 创建人),\n(update_time:datetime, 修改时间),\n(deleted:varchar, 删除状态，0-有效，1-已删除),\n(cause_by:varchar, 进度异常原因),\n(sprint_capacity:double, 迭代容量),\n(send_survey:varchar, 是否发送问卷),\n(name:varchar, 名称),\n(dispatch_to_name:varchar, 被分配人名称),\n(start_time:date, 开始时间),\n(business_value:text, 业务实施价值),\n(last_update_by:varchar, 最后修改人),\n(actual_start_time:date, 实际开始日期),\n(product_responsible_people:varchar, 产品负责人),\n(pmo:varchar, pmo),\n(performance_testing_sprint:varchar, 是否是性能测试迭代（0-否，1-是）),\n(remark:text, 备注),\n(id:bigint, 主键),\n(status:varchar, 状态),\n(develop_responsible_people:varchar, 开发负责人),\n(end_time:date, 结束时间),\n(goal:text, 迭代目标),\n(create_time:datetime, 创建时间),\n(actual_end_time:date, 实际结束日期),\n(current_status:varchar, 当前进度状态),\n(is_auto_create_task_package:varchar, 自动创建关联任务包开关),\n(performance_testing_sprint_reason:varchar, 性能测试迭代原因),\n(financial_code_id:bigint, 关联财务编码id(纯bug迭代使用))\n]\n# Table: d_organization, 机构表，id为组织ID，organization_name为部门名称\n[\n(id:bigint, 主键id),\n(level:varchar, 机构层级),\n(create_by:varchar, 创建人),\n(is_team:varchar, 是否团队：1是：0否),\n(second_team_leader:varchar, 二级负责人),\n(wc_parent_id:int, 企微组织父级ID),\n(organization_name:varchar, 机构名称),\n(parent_id:bigint, 上级机构),\n(update_time:datetime, 更新时间),\n(team_leader:varchar, 负责人),\n(deleted:varchar, 删除状态，