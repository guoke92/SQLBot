rchar, 项目名称),\n(forecast_year:varchar, 项目年份),\n(forecast_week_end_date:varchar, 项目周记录日),\n(diff_amount:decimal),\n(center_name:varchar, 归属中心),\n(last_edit_user:varchar, 最后修改用户),\n(update_time:varchar, 修改时间),\n(revenue_diff_amount:decimal, 收入差异金额),\n(revenue_year_diff_reason:varchar, 年初收入预算差异原因),\n(conditions_or_needs:varchar, 实现条件或需求),\n(third_channel_fee:decimal, 渠道费（返第三方）),\n(last_business_progress:varchar, 最新业务进展),\n(business_type:varchar, 业务类型),\n(capital_partner_conn:varchar, 资方对接情况),\n(custom_total_revenue:decimal, 客户合计-收入--不含渠道返润（万）),\n(total_channel_fee:decimal, 返润合计),\n(custom_name:varchar, 客户名称),\n(product_type:varchar, 产品类型)\n]\n# Table: zhanke_revenue_week_forecast_record, 战客项目周预测轮次记录表\n[\n(forecast_id:int, 预测记录编号),\n(project_end_month:varchar, 项目截止月份),\n(forecast_end_date:varchar, 预测结束日期),\n(create_time:varchar, 新建时间),\n(project_start_month:varchar, 项目起始月份),\n(forecast_start_date:varchar, 预测起始日期),\n(last_edit_user:varchar, 最后修改用户),\n(update_time:varchar, 修改时间)\n]\n# Table: zhanke_revenue_fin_info, 战客收入预测资方信息表\n[\n(id:int, 自增ID),\n(center_name:varchar, 中心名称),\n(group_name:varchar, 部门名称),\n(custom_detail_name:varchar, 集团/核心企业),\n(business_type:varchar, 业务类型),\n(create_time:datetime, 创建时间),\n(project_name:varchar, 项目名称),\n(fin_name:varchar, 资金方),\n(product_type:varchar, 产品类型),\n(update_time:datetime, 更新时间)\n]\n# Table: zhanke_project_revenue_forecast_month_test, 战客项目月度收入预测录入表\n[\n(project_name:varchar, 项目名称),\n(forecast_year:varchar, 年份),\n(asset_amount:decimal, 资产规模),\n(traffic_revenue:decimal, 收入-流量),\n(total_revenue:decimal, 月收入小计),\n(group_name:varchar, 归属团队),\n(create_time:varchar, 新建时间),\n(project_month_id:int, 编号),\n(project_type:varchar, 项目类型),\n(forecast_month:varchar, 月份),\n(avail_charge_amount:decimal, 、可收费规模),\n(develop_revenue:decimal, 收入-开发),\n(center_name:varchar, 归属中心),\n(last_edit_user:varchar, 最后修改用户),\n(update_time:varchar, 修改时间)\n]\n# Table: zhanke_project_revenue_forecast_year_test, 战客项目年度收入预测录入表\n[\n(project_name:varchar, 项目名称),\n(tot