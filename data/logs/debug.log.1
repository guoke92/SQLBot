\n(wc_id:varchar, 企微组织ID),\n(wc_main_depart:int, 企微主部门id),\n(wc_remove_date:date, 企微账户删除日期),\n(need_report_ka_workload:tinyint, 是否需要报工，默认为不需要)\n]\n# Table: d_task, Task表，关联项目(project_id)和迭代(sprint_id)，dispatch_to_name为分配人，deleted为删除标记\n[\n(id:bigint, 主键),\n(project_id:bigint, 所属项目id),\n(task_description:longtext, 任务描述),\n(status:varchar, 状态),\n(plan_workload:decimal, 预估工作量),\n(plan_end_time:date, 计划结束时间),\n(create_by:varchar, 创建人),\n(update_time:datetime, 修改时间),\n(schedule:decimal, task进度(默认为0)),\n(tag_name:varchar, 层级名称),\n(title:varchar, 标题),\n(dispatch_to:bigint, 被分配人),\n(sprint_id:bigint, 迭代表id),\n(actually_workload:decimal, 实际工作量),\n(actually_start_time:date, 实际开始时间),\n(last_update_by:varchar, 最后修改人),\n(deleted:varchar, 删除状态，0-有效，1-已删除),\n(work_sheet_id:bigint, 关联工单ID),\n(parent_id:bigint, 父级id),\n(content:longtext, 主体内容),\n(dispatch_to_name:varchar, 被分配人名称),\n(priority:varchar, 优先级),\n(plan_start_time:date, 计划开始时间),\n(actually_end_time:date, 实际结束时间),\n(create_time:datetime, 创建时间),\n(item_no:varchar, 编号),\n(remark:text, 备注)\n]\n# Table: d_qa_case, 测试用例表，id为用例ID，deleted为删除标记\n[\n(group_id:bigint, 所属分组id),\n(precondition:text, 前置条件),\n(expected_result:text, 预期结果),\n(auto_test_switch:int, 是否同步创建0否1是),\n(update_time:datetime, 修改时间),\n(deleted:varchar, 删除状态，0-未删除，1-已删除),\n(self_result:varchar, 自测结论：PASS:通过、FAILED:不通过),\n(sprint_id:bigint, 迭代id),\n(project_id1:bigint, 系统id),\n(id:bigint, 用例id),\n(priority:varchar, 优先级),\n(describe_type:int, 1文本描述 2步骤描述),\n(test_count:int, 测试次数),\n(create_time:datetime, 创建时间),\n(update_by:varchar, 修改人),\n(case_url:longtext, 接口测试url地址),\n(test_times:int, 提测次数),\n(test_type:varchar, 测试类型：sit,uat),\n(title:varchar, 用例标题),\n(story_id:bigint, 关联需求),\n(text_describe:text, 文本描述内容),\n(is_smoke:int, 是否冒烟用例0否1是),\n(create_by:varchar, 创建人),\n(item_no:varchar, 编号),\n(is_api_case:int, 是否接口测试案例：1-是，0-否),\n(smoke_result:varchar, 冒烟结论),\n(type:varchar, 所属用例库，全量用例库，回归用例库)\n]\n\n\n【Sample Data】(first 5 rows, for chart reference)\n| person_name | org_na