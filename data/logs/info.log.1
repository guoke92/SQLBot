  `department`,
  `person_name`,
  `month`,
  `code`,
  `project_name`,
  `sprint_name`,
  SUM(`story_count`) AS `story_count`,
  SUM(`task_count`) AS `task_count`,
  SUM(`case_count`) AS `case_count`
FROM (
  SELECT 
    `u`.`organization_name` AS `department`,
    `u`.`name` AS `person_name`,
    DATE_FORMAT(`sp`.`actual_end_time`, '%Y-%m') AS `month`,
    `p`.`code` AS `code`,
    `p`.`project_name` AS `project_name`,
    `sp`.`name` AS `sprint_name`,
    COUNT(`s`.`id`) AS `story_count`,
    0 AS `task_count`,
    0 AS `case_count`
  FROM `d_story` `s`
  JOIN `d_user` `u` ON `s`.`dispatch_to` = `u`.`id`
  JOIN `d_project` `p` ON `s`.`project_id` = `p`.`id`
  JOIN `d_sprint` `sp` ON `s`.`sprint_id` = `sp`.`id`
  WHERE `s`.`deleted` = '0' AND YEAR(`sp`.`actual_end_time`) = 2026
  GROUP BY `u`.`organization_name`, `u`.`name`, DATE_FORMAT(`sp`.`actual_end_time`, '%Y-%m'), `p`.`code`, `p`.`project_name`, `sp`.`name`

  UNION ALL

  SELECT 
    `u`.`organization_name` AS `department`,
    `u`.`name` AS `person_name`,
    DATE_FORMAT(`sp`.`actual_end_time`, '%Y-%m') AS `month`,
    `p`.`code` AS `code`,
    `p`.`project_name` AS `project_name`,
    `sp`.`name` AS `sprint_name`,
    0 AS `story_count`,
    COUNT(`t`.`id`) AS `task_count`,
    0 AS `case_count`
  FROM `d_task` `t`
  JOIN `d_user` `u` ON `t`.`dispatch_to` = `u`.`id`
  JOIN `d_project` `p` ON `t`.`project_id` = `p`.`id`
  JOIN `d_sprint` `sp` ON `t`.`sprint_id` = `sp`.`id`
  WHERE `t`.`deleted` = '0' AND YEAR(`sp`.`actual_end_time`) = 2026
  GROUP BY `u`.`organization_name`, `u`.`name`, DATE_FORMAT(`sp`.`actual_end_time`, '%Y-%m'), `p`.`code`, `p`.`project_name`, `sp`.`name`

  UNION ALL

  SELECT 
    `u`.`organization_name` AS `department`,
    `u`.`name` AS `person_name`,
    DATE_FORMAT(`sp`.`actual_end_time`, '%Y-%m') AS `month`,
    `p`.`code` AS `code`,
    `p`.`project_name` AS `project_name`,
    `sp`.`name` AS `sprint_name`,
    0 AS `story_count`,
    0 AS `task_count`,
    COUNT(`c`.`id`) AS `case_count`
  FROM `d_qa_case` `c`
  JOIN `d_user` `u` ON `c`.`create_by` = `u`.`name`
  JOIN `d_project` `p` ON `c`.`project_id1` = `p`.`id`
  JOIN `d_sprint` `sp` ON `c`.`sprint_id` = `sp`.`id`
  WHERE `c`.`deleted` = '0' AND YEAR(`sp`.`actual_end_time`) = 2026
  GROUP BY `u`.`organization_name`, `u`.`name`, DATE_FORMAT(`sp`.`actual_end_time`, '%Y-%m'), `p`.`code`, `p`.`project_name`, `sp`.`name`
) AS `combined`
GROUP BY `department`, `person_name`, `month`, `code`, `project_name`, `sprint_name`
LIMIT 1000
