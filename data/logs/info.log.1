# Table: d_story, Story表，关联项目(project_id)和迭代(sprint_id)，dispatch_to_name为负责开发人员，deleted为删除标记
[
(id:bigint, 主键),
(tag_name:varchar, 层级名称),
(parent_id:bigint, 父级id),
(project_id:bigint, 所属项目id),
(title:varchar, 标题),
(content:longtext, 主体内容),
(business_rule_description:longtext, 业务规则描述),
(modify_reason:text, 关联改造说明),
(other_support_info:text, 其它支撑信息),
(accept_condition:longtext, 验收条件),
(prototype_url:varchar, 原型地址),
(product_manager:varchar, 产品经理),
(dispatch_to:bigint, 被分配人),
(dispatch_to_name:varchar, 被分配人名称),
(test_person:varchar, 测试负责人),
(status:varchar, 状态),
(priority:varchar, 优先级),
(sprint_id:bigint, 迭代表id),
(plan_workload:decimal, 预估工作量),
(plan_workload_frontend:decimal, 预估前端工作量),
(plan_workload_backend:decimal, 预估后端工作量),
(plan_workload_test:decimal, 预估测试工作量),
(plan_workload_other:decimal, 预估其他工作量),
(actually_workload:decimal, 实际工作量),
(plan_start_time:date, 计划开始时间),
(plan_end_time:date, 计划结束时间),
(actually_start_time:date, 实际开始时间),
(actually_end_time:date, 实际待发布时间),
(accepting_time:date, 转验收中时间),
(create_by:varchar, 创建人),
(last_update_by:varchar, 最后修改人),
(create_time:datetime, 创建时间),
(update_time:datetime, 修改时间),
(graphical_requirement:longtext, 界面要求),
(description:longtext, 描述信息),
(bussiness_id:bigint, 关联业务需求),
(product_id:bigint, 关联产品),
(product_model_id:text, 关联产品模块),
(deleted:varchar, 删除状态，0-有效，1-已删除),
(item_no:varchar, 编号),
(order_no:varchar, 提测单号),
(test_status:varchar, story提测状态：WAIT_COMMITTED:待提交、AUDITING:审核中、PASS:通过、FAILED:未通过),
(actual_to_test_date:date, 实际转测日期),
